rules_version = '2';

// ===============================================================
// Assumed Data Model — CETEP Tech Study (cetep-tech-study)
// ===============================================================
//
// This security rules file enforces strict per-user isolation,
// 3-tier role-based access control ('aluno', 'professor', 'admin'),
// class-scoped teacher authorization, server-controlled teacher
// invites, schema validation, and anti-privilege-escalation invariants.
//
// Collection: /users/{userId}
// Document ID: Firebase Auth UID
// Fields:
//   - id: string (optional, <= 128 chars, immutable) - Legacy/internal ID
//   - uid: string (optional, must match userId, immutable) - Auth UID
//   - name: string (required, 1..120 chars) - User display name
//   - email: string (required, 3..254 chars) - User email address (PII)
//   - role: string (required, 'aluno' on public create, immutable from student client) - User role
//   - photoURL: string|null (optional, <= 500 chars) - Avatar URL
//   - emailVerified: bool (optional) - Email verification flag
//   - authProviders: list (optional, <= 10 items) - Linked auth providers
//   - migratedFromLocal: bool (optional) - LocalStorage migration marker
//   - assignedClassIds: list (optional, <= 50 items) - Classes assigned to teacher
//   - enrolledClassIds: list (optional, <= 50 items) - Classes student is enrolled in
//   - createdAt: timestamp|string (optional, immutable on update) - Creation time
//   - updatedAt: timestamp|string (optional) - Last update time
//
// Subcollections under /users/{userId}:
//   - /tasks/{taskId}
//   - /agenda/{eventId}
//   - /focusSessions/{sessionId}
//   - /appdata/{docId} ('gamification', 'settings', 'weeklyPlan', 'studyProgress')
//
// Collection: /classes/{classId}
// Fields:
//   - id, name (1..150), code, course, shift, year, description,
//     subjects (list <= 40), teacherIds (list <= 30), teacherNames (list <= 30),
//     studentIds (list <= 200), createdBy, createdAt, updatedAt
// Subcollections under /classes/{classId}:
//   - /contents/{contentId}
//   - /activities/{activityId}
//   - /announcements/{announcementId}
//
// Collection: /teacherInvites/{inviteId}
// Fields:
//   - id, codePreview, codeHash, targetEmail (3..254), assignedClassIds (list <= 50),
//     createdBy, createdByName, expiresAt, used, usedByUid, usedAt,
//     revoked, createdAt, updatedAt
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the authenticated user owns the resource path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Read the role stored on the authenticated user's profile document
    // (Protected by anti-privilege-escalation rules on /users/{userId})
    function userDocRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'aluno';
    }

    // Check if the user has Admin authority (custom claim or verified admin profile)
    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.admin == true ||
         request.auth.token.role == 'admin' ||
         userDocRole() == 'admin');
    }

    // Check if the user has Teacher ('professor') authority
    function isTeacher() {
      return isAuthenticated() &&
        (request.auth.token.role == 'professor' ||
         userDocRole() == 'professor');
    }

    // Check if the user is a Teacher or Admin (pedagogical staff)
    function isStaff() {
      return isAdmin() || isTeacher();
    }

    // Check if the authenticated teacher is assigned to a class document's data
    function isAssignedTeacherOfClassData(classData) {
      return isTeacher() &&
        ('teacherIds' in classData) &&
        (request.auth.uid in classData.teacherIds);
    }

    // Check if the authenticated student is enrolled in a class document's data
    function isEnrolledStudentOfClassData(classData) {
      return isAuthenticated() &&
        ('studentIds' in classData) &&
        (request.auth.uid in classData.studentIds);
    }

    // Check if the authenticated teacher is assigned to a specific class by classId
    function isClassTeacher(classId) {
      return isTeacher() &&
        exists(/databases/$(database)/documents/classes/$(classId)) &&
        (request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.teacherIds);
    }

    // Check if the authenticated user can manage a specific class (Admin or assigned Teacher)
    function canManageClass(classId) {
      return isAdmin() || isClassTeacher(classId);
    }

    // Check if the authenticated user can read a specific class (Admin, assigned Teacher, or enrolled Student)
    function canReadClass(classId) {
      return canManageClass(classId) ||
        (isAuthenticated() &&
         exists(/databases/$(database)/documents/classes/$(classId)) &&
         (request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.studentIds));
    }

    // Verify UID field hasn't been tampered with on create
    function uidUnchanged(userId) {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == userId;
    }

    // Ensure UID field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        !('uid' in resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Ensure immutable creation timestamp is not modified on update
    function createdAtUnchanged() {
      return !('createdAt' in request.resource.data) ||
        !('createdAt' in resource.data) ||
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate required string within length bounds
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Validate optional string (if present and non-null, must be string within length bounds)
    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is string && data[field].size() >= minLen && data[field].size() <= maxLen);
    }

    // Validate optional boolean
    function isValidOptionalBool(data, field) {
      return !(field in data) ||
        data[field] is bool;
    }

    // Validate optional number within range
    function isValidOptionalNumber(data, field, minVal, maxVal) {
      return !(field in data) ||
        data[field] == null ||
        (data[field] is number && data[field] >= minVal && data[field] <= maxVal);
    }

    // Validate optional timestamp or ISO date string
    function isValidOptionalTimestampOrDateString(data, field) {
      return !(field in data) ||
        data[field] == null ||
        data[field] is timestamp ||
        (data[field] is string && data[field].size() <= 40);
    }

    // ===============================================================
    // Domain Validators (Used in BOTH create and update rules)
    // ===============================================================

    function isValidUserProfile(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'uid', 'name', 'email', 'role', 'photoURL',
          'emailVerified', 'authProviders', 'migratedFromLocal',
          'assignedClassIds', 'enrolledClassIds',
          'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() >= 3 &&
        request.resource.data.email.size() <= 254 &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'uid', 1, 128) &&
        isValidOptionalString(data, 'photoURL', 0, 500) &&
        isValidOptionalBool(data, 'emailVerified') &&
        isValidOptionalBool(data, 'migratedFromLocal') &&
        (!('authProviders' in data) || (data.authProviders is list && data.authProviders.size() <= 10)) &&
        (!('assignedClassIds' in data) || (data.assignedClassIds is list && data.assignedClassIds.size() <= 50)) &&
        (!('enrolledClassIds' in data) || (data.enrolledClassIds is list && data.enrolledClassIds.size() <= 50)) &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidTask(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'description', 'subject', 'priority', 'dueDate',
          'deadline', 'estimatedMinutes', 'subtasks', 'status', 'xpAwarded',
          'createdAt', 'completedAt', 'updatedAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.status in ['pending', 'completed'] &&
        (!('subtasks' in request.resource.data) || (request.resource.data.subtasks is list && request.resource.data.subtasks.size() <= 50)) &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'description', 0, 2000) &&
        isValidOptionalString(data, 'subject', 0, 120) &&
        isValidOptionalString(data, 'priority', 0, 30) &&
        isValidOptionalString(data, 'dueDate', 0, 40) &&
        isValidOptionalString(data, 'deadline', 0, 40) &&
        (!( 'estimatedMinutes' in data ) || data.estimatedMinutes == null || (data.estimatedMinutes is number && data.estimatedMinutes >= 0 && data.estimatedMinutes <= 1440)) &&
        isValidOptionalBool(data, 'xpAwarded') &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'completedAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidAgendaEvent(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'title', 'date', 'time', 'type', 'priority', 'subject',
          'description', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.title is string &&
        request.resource.data.title.size() >= 1 &&
        request.resource.data.title.size() <= 300 &&
        request.resource.data.date is string &&
        request.resource.data.date.size() >= 8 &&
        request.resource.data.date.size() <= 30 &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'time', 0, 20) &&
        isValidOptionalString(data, 'type', 0, 50) &&
        isValidOptionalString(data, 'priority', 0, 30) &&
        isValidOptionalString(data, 'subject', 0, 120) &&
        isValidOptionalString(data, 'description', 0, 2000) &&
        isValidOptionalString(data, 'notes', 0, 2000) &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidFocusSession(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'sessionId', 'durationMinutes', 'plannedMinutes',
          'elapsedSeconds', 'completed', 'subject', 'xpAwarded',
          'pointsEarned', 'completedAt', 'createdAt'
        ]) &&
        request.resource.data.durationMinutes is number &&
        request.resource.data.durationMinutes >= 1 &&
        request.resource.data.durationMinutes <= 300 &&
        (!('completed' in request.resource.data) || request.resource.data.completed is bool) &&
        (!('pointsEarned' in request.resource.data) || (request.resource.data.pointsEarned is number && request.resource.data.pointsEarned >= 0 && request.resource.data.pointsEarned <= 100)) &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'sessionId', 1, 128) &&
        (!('plannedMinutes' in data) || data.plannedMinutes == null || (data.plannedMinutes is number && data.plannedMinutes >= 1 && data.plannedMinutes <= 300)) &&
        (!('elapsedSeconds' in data) || data.elapsedSeconds == null || (data.elapsedSeconds is number && data.elapsedSeconds >= 0 && data.elapsedSeconds <= 18000)) &&
        isValidOptionalString(data, 'subject', 0, 120) &&
        isValidOptionalBool(data, 'xpAwarded') &&
        isValidOptionalTimestampOrDateString(data, 'completedAt') &&
        isValidOptionalTimestampOrDateString(data, 'createdAt');
    }

    function isValidGamificationAppData(data) {
      return (request.resource.data.points is int || request.resource.data.points is number) &&
        request.resource.data.points >= 0 &&
        (request.resource.data.level is int || request.resource.data.level is number) &&
        request.resource.data.level >= 1 &&
        request.resource.data.level <= 10 &&
        (request.resource.data.streakDays is int || request.resource.data.streakDays is number) &&
        request.resource.data.streakDays >= 0 &&
        (request.resource.data.bestStreak is int || request.resource.data.bestStreak is number) &&
        request.resource.data.bestStreak >= 0 &&
        (request.resource.data.streakShields is int || request.resource.data.streakShields is number) &&
        request.resource.data.streakShields >= 0 &&
        request.resource.data.streakShields <= 5 &&
        request.resource.data.achievements is list &&
        request.resource.data.achievements.size() <= 100 &&
        request.resource.data.activeDates is list &&
        request.resource.data.activeDates.size() <= 1000 &&
        request.resource.data.shieldUsedDates is list &&
        request.resource.data.shieldUsedDates.size() <= 500 &&
        request.resource.data.keys().hasOnly([
          'points', 'level', 'achievements', 'lastActiveDate',
          'streakDays', 'bestStreak', 'streakShields',
          'activeDates', 'shieldUsedDates', 'updatedAt'
        ]) &&
        isValidOptionalString(data, 'lastActiveDate', 0, 30) &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidSettingsAppData(data) {
      return request.resource.data.theme in ['light', 'dark', 'highcontrast', 'highcontrast-white'] &&
        request.resource.data.fontSize in ['small', 'medium', 'large', 'xlarge', 'huge'] &&
        request.resource.data.keys().hasOnly([
          'theme', 'fontSize', 'dyslexiaFont', 'reducedMotion', 'notifications', 'updatedAt'
        ]) &&
        isValidOptionalBool(data, 'dyslexiaFont') &&
        isValidOptionalBool(data, 'reducedMotion') &&
        isValidOptionalBool(data, 'notifications') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidWeeklyPlanAppData(data) {
      return request.resource.data.keys().hasOnly([
          '0', '1', '2', '3', '4', '5', '6',
          'seg', 'ter', 'qua', 'qui', 'sex', 'sab', 'dom', 'days', 'updatedAt'
        ]) &&
        (!('0' in data) || data['0'] is map) &&
        (!('1' in data) || data['1'] is map) &&
        (!('2' in data) || data['2'] is map) &&
        (!('3' in data) || data['3'] is map) &&
        (!('4' in data) || data['4'] is map) &&
        (!('5' in data) || data['5'] is map) &&
        (!('6' in data) || data['6'] is map) &&
        (!('seg' in data) || (data.seg is list && data.seg.size() <= 30) || data.seg is map) &&
        (!('ter' in data) || (data.ter is list && data.ter.size() <= 30) || data.ter is map) &&
        (!('qua' in data) || (data.qua is list && data.qua.size() <= 30) || data.qua is map) &&
        (!('qui' in data) || (data.qui is list && data.qui.size() <= 30) || data.qui is map) &&
        (!('sex' in data) || (data.sex is list && data.sex.size() <= 30) || data.sex is map) &&
        (!('sab' in data) || (data.sab is list && data.sab.size() <= 30) || data.sab is map) &&
        (!('dom' in data) || (data.dom is list && data.dom.size() <= 30) || data.dom is map) &&
        (!('days' in data) || data.days is map) &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidStudyProgressAppData(data) {
      return request.resource.data.completedExercises is list &&
        request.resource.data.completedExercises.size() <= 500 &&
        request.resource.data.keys().hasOnly([
          'completedExercises', 'lastVisitedTab', 'updatedAt'
        ]) &&
        isValidOptionalString(data, 'lastVisitedTab', 0, 100) &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidAppData(docId, data) {
      return (docId == 'gamification' && isValidGamificationAppData(data)) ||
        (docId == 'settings' && isValidSettingsAppData(data)) ||
        (docId == 'weeklyPlan' && isValidWeeklyPlanAppData(data)) ||
        (docId == 'studyProgress' && isValidStudyProgressAppData(data));
    }

    function isValidClass(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'name', 'code', 'course', 'shift', 'year', 'description',
          'subjects', 'teacherIds', 'teacherNames', 'studentIds',
          'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 150 &&
        data.teacherIds is list &&
        data.teacherIds.size() <= 30 &&
        data.studentIds is list &&
        data.studentIds.size() <= 200 &&
        (!('subjects' in data) || (data.subjects is list && data.subjects.size() <= 40)) &&
        (!('teacherNames' in data) || (data.teacherNames is list && data.teacherNames.size() <= 30)) &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'code', 0, 40) &&
        isValidOptionalString(data, 'course', 0, 120) &&
        isValidOptionalString(data, 'shift', 0, 40) &&
        isValidOptionalString(data, 'year', 0, 20) &&
        isValidOptionalString(data, 'description', 0, 1000) &&
        isValidOptionalString(data, 'createdBy', 0, 128) &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidClassContent(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'classId', 'title', 'subject', 'description',
          'resourceUrl', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.subject is string &&
        data.subject.size() >= 1 &&
        data.subject.size() <= 120 &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'classId', 1, 128) &&
        isValidOptionalString(data, 'description', 0, 3000) &&
        isValidOptionalString(data, 'resourceUrl', 0, 1000) &&
        isValidOptionalString(data, 'authorId', 0, 128) &&
        isValidOptionalString(data, 'authorName', 0, 120) &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidClassActivity(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'classId', 'title', 'subject', 'type', 'dueDate',
          'points', 'description', 'authorId', 'authorName', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.subject is string &&
        data.subject.size() >= 1 &&
        data.subject.size() <= 120 &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'classId', 1, 128) &&
        isValidOptionalString(data, 'type', 0, 50) &&
        isValidOptionalString(data, 'dueDate', 0, 40) &&
        (!('points' in data) || data.points == null || (data.points is number && data.points >= 0 && data.points <= 1000)) &&
        isValidOptionalString(data, 'description', 0, 3000) &&
        isValidOptionalString(data, 'authorId', 0, 128) &&
        isValidOptionalString(data, 'authorName', 0, 120) &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidClassAnnouncement(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'classId', 'title', 'message', 'priority',
          'authorId', 'authorName', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 200 &&
        data.message is string &&
        data.message.size() >= 1 &&
        data.message.size() <= 3000 &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'classId', 1, 128) &&
        isValidOptionalString(data, 'priority', 0, 30) &&
        isValidOptionalString(data, 'authorId', 0, 128) &&
        isValidOptionalString(data, 'authorName', 0, 120) &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    function isValidTeacherInvite(data) {
      return request.resource.data.keys().hasOnly([
          'id', 'codePreview', 'codeHash', 'targetEmail', 'assignedClassIds',
          'createdBy', 'createdByName', 'expiresAt', 'used', 'usedByUid',
          'usedAt', 'revoked', 'createdAt', 'updatedAt'
        ]) &&
        data.targetEmail is string &&
        data.targetEmail.size() >= 3 &&
        data.targetEmail.size() <= 254 &&
        isValidOptionalString(data, 'id', 1, 128) &&
        isValidOptionalString(data, 'codePreview', 0, 40) &&
        isValidOptionalString(data, 'codeHash', 0, 256) &&
        (!('assignedClassIds' in data) || (data.assignedClassIds is list && data.assignedClassIds.size() <= 50)) &&
        isValidOptionalString(data, 'createdBy', 0, 128) &&
        isValidOptionalString(data, 'createdByName', 0, 120) &&
        isValidOptionalBool(data, 'used') &&
        isValidOptionalBool(data, 'revoked') &&
        isValidOptionalString(data, 'usedByUid', 0, 128) &&
        isValidOptionalTimestampOrDateString(data, 'expiresAt') &&
        isValidOptionalTimestampOrDateString(data, 'usedAt') &&
        isValidOptionalTimestampOrDateString(data, 'createdAt') &&
        isValidOptionalTimestampOrDateString(data, 'updatedAt');
    }

    // ===============================================================
    // Collection Rules: /users/{userId}
    // ===============================================================

    match /users/{userId} {
      // Students can only get their own profile; verified teachers/admins can get individual profiles;
      // Unrestricted collection listing is restricted strictly to Admins (teachers search students via Admin SDK endpoint)
      allow get: if isOwner(userId) || isStaff();
      allow list: if isAdmin();

      // Public sign-up MUST set role == 'aluno' and empty assignedClassIds;
      // Only Admins can directly create 'professor' or 'admin' user profiles
      allow create: if (isOwner(userId) &&
        request.resource.data.role == 'aluno' &&
        (!('assignedClassIds' in request.resource.data) || request.resource.data.assignedClassIds.size() == 0) &&
        uidUnchanged(userId) &&
        isValidUserProfile(request.resource.data)) ||
        (isAdmin() &&
         request.resource.data.role in ['aluno', 'professor', 'admin'] &&
         isValidUserProfile(request.resource.data));

      // Role and assignedClassIds are strictly immutable from student/teacher self-updates;
      // Admins can manage roles & class assignments; Teachers can update enrolledClassIds on student enrollment
      allow update: if (isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        (!('assignedClassIds' in request.resource.data) ||
         ('assignedClassIds' in resource.data && request.resource.data.assignedClassIds == resource.data.assignedClassIds)) &&
        uidNotModified() &&
        createdAtUnchanged() &&
        isValidUserProfile(request.resource.data)) ||
        (isAdmin() &&
         request.resource.data.role in ['aluno', 'professor', 'admin'] &&
         uidNotModified() &&
         isValidUserProfile(request.resource.data)) ||
        (isTeacher() &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolledClassIds', 'updatedAt']) &&
         isValidUserProfile(request.resource.data));

      // Students can delete their own profile; Admins can delete accounts
      allow delete: if isOwner(userId) || isAdmin();

      // ---------------------------------------------------------------
      // Subcollection: /users/{userId}/tasks/{taskId}
      // ---------------------------------------------------------------
      match /tasks/{taskId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isOwner(userId) && isValidTask(request.resource.data);
        allow update: if isOwner(userId) && createdAtUnchanged() && isValidTask(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // ---------------------------------------------------------------
      // Subcollection: /users/{userId}/agenda/{eventId}
      // ---------------------------------------------------------------
      match /agenda/{eventId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isOwner(userId) && isValidAgendaEvent(request.resource.data);
        allow update: if isOwner(userId) && createdAtUnchanged() && isValidAgendaEvent(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // ---------------------------------------------------------------
      // Subcollection: /users/{userId}/focusSessions/{sessionId}
      // ---------------------------------------------------------------
      match /focusSessions/{sessionId} {
        allow read: if isOwner(userId) || isStaff();
        allow create: if isOwner(userId) && isValidFocusSession(request.resource.data);
        allow update: if isOwner(userId) && createdAtUnchanged() && isValidFocusSession(request.resource.data);
        allow delete: if isOwner(userId);
      }

      // ---------------------------------------------------------------
      // Subcollection: /users/{userId}/appdata/{docId}
      // ---------------------------------------------------------------
      match /appdata/{docId} {
        allow read: if (isOwner(userId) || isStaff()) &&
          docId in ['gamification', 'settings', 'weeklyPlan', 'studyProgress'];
        allow create, update: if isOwner(userId) &&
          docId in ['gamification', 'settings', 'weeklyPlan', 'studyProgress'] &&
          isValidAppData(docId, request.resource.data);
        allow delete: if isOwner(userId) &&
          docId in ['gamification', 'settings', 'weeklyPlan', 'studyProgress'];
      }
    }

    // ===============================================================
    // Collection Rules: /classes/{classId}
    // ===============================================================

    match /classes/{classId} {
      // Admins can read all classes; Teachers can read ONLY assigned classes; Students can read ONLY enrolled classes
      allow read: if isAdmin() ||
        isAssignedTeacherOfClassData(resource.data) ||
        isEnrolledStudentOfClassData(resource.data);

      // Only Admins can create or delete classes
      allow create: if isAdmin() && isValidClass(request.resource.data);
      allow delete: if isAdmin();

      // Admins can update any class field; Assigned Teachers can update class metadata/students but CANNOT modify teacherIds
      allow update: if (isAdmin() && isValidClass(request.resource.data)) ||
        (isAssignedTeacherOfClassData(resource.data) &&
         request.resource.data.teacherIds == resource.data.teacherIds &&
         isValidClass(request.resource.data));

      // ---------------------------------------------------------------
      // Subcollection: /classes/{classId}/contents/{contentId}
      // ---------------------------------------------------------------
      match /contents/{contentId} {
        allow read: if canReadClass(classId);
        allow create, update: if canManageClass(classId) && isValidClassContent(request.resource.data);
        allow delete: if canManageClass(classId);
      }

      // ---------------------------------------------------------------
      // Subcollection: /classes/{classId}/activities/{activityId}
      // ---------------------------------------------------------------
      match /activities/{activityId} {
        allow read: if canReadClass(classId);
        allow create, update: if canManageClass(classId) && isValidClassActivity(request.resource.data);
        allow delete: if canManageClass(classId);
      }

      // ---------------------------------------------------------------
      // Subcollection: /classes/{classId}/announcements/{announcementId}
      // ---------------------------------------------------------------
      match /announcements/{announcementId} {
        allow read: if canReadClass(classId);
        allow create, update: if canManageClass(classId) && isValidClassAnnouncement(request.resource.data);
        allow delete: if canManageClass(classId);
      }

      // ---------------------------------------------------------------
      // Subcollection: /classes/{classId}/auditLogs/{logId}
      // ---------------------------------------------------------------
      match /auditLogs/{logId} {
        allow get, list: if isAdmin() || isClassTeacher(classId);
        allow create: if (isAdmin() || isClassTeacher(classId)) &&
          request.resource.data.classId == classId &&
          isValidString(request.resource.data.action, 1, 80) &&
          isValidString(request.resource.data.actorUid, 1, 128) &&
          request.resource.data.actorUid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ===============================================================
    // Collection Rules: /teacherInvites/{inviteId}
    // ===============================================================

    match /teacherInvites/{inviteId} {
      // Strictly Admin-only; students and teachers cannot read or write invites directly from client
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin() && isValidTeacherInvite(request.resource.data);
    }

    // ===============================================================
    // Default Deny — Reject all unmatched paths
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
